# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db

# ── LLM Provider (all AI calls: interview, profiling, KPI suggestion) ─────────
# "openai" (default) | "anthropic" — switch here only, no code change required
LLM_PROVIDER=openai

# ── AI — OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── AI — Anthropic (set LLM_PROVIDER=anthropic to activate) ──────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AI — Azure OpenAI (set LLM_PROVIDER=azure to activate) ───────────────────
USE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── AI — ADK Agent (Flow 2 — disabled by default) ────────────────────────────
# ADK_ENABLED: true = ADK agent primary, OpenAI auto-fallback on failure
#              false = LLM_PROVIDER only (Flow 1, default)
ADK_ENABLED=false
ADK_PROVIDER=openai
ADK_MODEL=gpt-4o-mini

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_EXCEL_ROWS=200000
MAX_CSV_ROWS=200000
MAX_UPLOAD_FILES=10
MAX_COLUMNS_PER_FILE=200

# ── Storage (leave blank for local dev storage) ───────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
REDIS_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
