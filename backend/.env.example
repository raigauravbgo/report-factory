# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db

# ── AI — Flow 1: Interview/Recipe chat (OpenAI) ───────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── AI — Flow 2: ADK Agent model provider ────────────────────────────────────
# Option A — OpenAI via LiteLLM (default, uses OPENAI_API_KEY above, no extra key)
ADK_PROVIDER=openai
ADK_MODEL=gpt-4o-mini

# Option B — Claude via Anthropic (uncomment + set key to switch)
# ADK_PROVIDER=anthropic
# ADK_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=

# ── AWS S3 (production only — leave blank for MVP local storage) ──────────────
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50
REDIS_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
