# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./dev.db

# MySQL (optional, for production):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bgo_dashboard

# ── AI ────────────────────────────────────────────────────────────────────────
# Required for AI schema inference and AI interview features:
OPENAI_API_KEY=sk-...

# Optional: Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# USE_AZURE_OPENAI=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave empty to use local filesystem (./local_uploads/):
S3_BUCKET=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50
SESSION_STORAGE_PATH=./sessions
UPLOAD_STORAGE_PATH=./local_uploads
